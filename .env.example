# AEGIS environment variables (development defaults — not production secrets)

# Runtime environment: development | test | production
AEGIS_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL (authoritative durable state)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev

# Redis (streams, cache, worker coordination)
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aegis
S3_SECRET_KEY=aegis_dev_secret
S3_BUCKET=aegis-artifacts

# Application ports
API_PORT=8000
WEB_PORT=3000

# Simulation tick engine (in the API process — the single writer that advances runs).
# Every RUNNING run is stepped AEGIS_SIM_STEPS_PER_TICK times every
# AEGIS_SIM_TICK_INTERVAL_SECONDS. A run auto-completes (STOP + after-action) once its
# virtual clock has advanced AEGIS_SIM_MAX_SIM_SECONDS past its start (Operation Silent
# Relay's full scripted narrative fires by ~00:21:00). Raise STEPS_PER_TICK or lower the
# interval for a faster-playing engagement; drop STEPS_PER_TICK to 1 for a slow-motion
# engagement you can narrate. The default plays a full Silent Relay run in ~8 minutes.
AEGIS_SIM_TICK_ENABLED=true
AEGIS_SIM_TICK_INTERVAL_SECONDS=2.0
AEGIS_SIM_STEPS_PER_TICK=4
AEGIS_SIM_MAX_SIM_SECONDS=1500

# Web client data source: fixture (local validated fixtures) | api (FastAPI backend).
# The shipped fresh-install experience uses the real backend (`api`), so the app
# starts EMPTY and fills in only after you start a run. Switch to `fixture` for
# offline UI development with pre-canned demo data.
NEXT_PUBLIC_AEGIS_DATA_SOURCE=api

# FastAPI base URL when NEXT_PUBLIC_AEGIS_DATA_SOURCE=api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Live command centre (Phase 13)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/realtime
# Deprecated Phase 12 token; Phase 30 uses /api/v1/auth/ws-ticket with session cookies.
NEXT_PUBLIC_AEGIS_WS_TOKEN=
NEXT_PUBLIC_AEGIS_CSRF_COOKIE_NAME=aegis_csrf

# Phase 30 authentication and authorization
# Real username/password auth is always available (POST /api/v1/auth/login) plus a
# self-disabling first-run "create admin" flow (POST /api/v1/auth/setup). The dev
# identity picker below is a LOCAL convenience only — the shipped Docker stack
# defaults it OFF so a fresh user gets the real sign-in. Leave true for local dev.
AEGIS_DEV_AUTH_ENABLED=true
AEGIS_SESSION_COOKIE_NAME=aegis_session
AEGIS_CSRF_COOKIE_NAME=aegis_csrf
AEGIS_CSRF_HEADER_NAME=X-CSRF-Token
AEGIS_SESSION_TTL_SECONDS=28800
AEGIS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AEGIS_OIDC_ENABLED=false
AEGIS_OIDC_ISSUER=
AEGIS_OIDC_CLIENT_ID=
AEGIS_OIDC_CLIENT_SECRET=
AEGIS_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AEGIS_OIDC_SCOPES=openid profile email
AEGIS_WEB_BASE_URL=http://localhost:3000

# Encrypts the model-provider API keys operators connect in Configure Loadout, so a run
# can bill their own OpenAI / OpenRouter / Ollama Cloud subscription. Leave blank and
# those endpoints report a configuration error — nothing else is affected, and the local
# model keeps working. scripts/bootstrap.sh generates one into .env if it is missing.
# Generate manually with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this strands every stored key; operators simply reconnect their providers.
AEGIS_CREDENTIAL_ENCRYPTION_KEY=

# Phase 31 observability (OpenTelemetry)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aegis-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_EXPORT_INTERVAL_MS=15000
OTEL_EXPORTER_FAILURE_MODE=ignore
AEGIS_HEALTH_PROBE_TIMEOUT_MS=2000
AEGIS_READY_REQUIRE_REDIS=true
AEGIS_READY_REQUIRE_OBJECT_STORAGE=true
AEGIS_LOG_JSON=true
AEGIS_TELEMETRY_RETENTION_HOURS=168

# Phase 32 API trust-boundary hardening
AEGIS_REQUEST_BODY_MAX_BYTES=1048576
AEGIS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
AEGIS_RATE_LIMIT_BURST=30
AEGIS_RATE_LIMIT_MAX_BUCKETS=10000
# HSTS is emitted only when both AEGIS_ENV=production and this flag are true.
AEGIS_SECURITY_HSTS_ENABLED=false
AEGIS_SECURITY_HSTS_MAX_AGE_SECONDS=31536000

# Worker mode for outbox relay
AEGIS_WORKER_MODE=outbox-relay

# Phase 18 model provider abstraction.
# `mock` keeps every environment offline (the safe default for CI/tests). The
# Phase 3 AI copilot needs a real model: set AEGIS_PROVIDER_DEFAULT=openai-compatible
# and point AEGIS_PROVIDER_LOCAL_* at a llama-server (below). docker-compose already
# defaults the api/worker services to openai-compatible + the local model.
AEGIS_PROVIDER_DEFAULT=mock
# Timeout budget chain (each layer MUST resolve before the one above it):
#   provider attempt ceiling  AEGIS_PROVIDER_TIMEOUT_SECONDS
#   < provider total budget   = agent task timeout - 2s headroom (set per request)
#   < agent task timeout      AEGIS_AGENT_TASK_TIMEOUT_SECONDS
#   < copilot client deadline (apps/web, 600s)
# When the provider outlives the task deadline it gets cancelled mid-flight and
# the operator sees "Provider request was cancelled (PROVIDER_FAILURE)" instead
# of an honest timeout. Measured on the local 27B reasoning model: ~76 tok/s
# prompt prefill, ~27 tok/s generation, so one real turn is 90-165s.
AEGIS_PROVIDER_TIMEOUT_SECONDS=60
AEGIS_PROVIDER_MAX_RETRIES=3
AEGIS_PROVIDER_RETRY_BACKOFF_SECONDS=1
# Backoff used instead of the exponential one when the endpoint reports it is
# still loading its weights (llama-server lazy-loads a multi-GB GGUF and 503s
# for minutes; 1s/2s/4s burns every retry inside seven seconds).
AEGIS_PROVIDER_COLD_START_BACKOFF_SECONDS=15
# Bound on the admin-facing provider reachability probe (a /v1/models GET).
AEGIS_PROVIDER_PROBE_TIMEOUT_MS=3000
AEGIS_PROVIDER_CIRCUIT_BREAKER_THRESHOLD=5
AEGIS_PROVIDER_CIRCUIT_BREAKER_RESET_SECONDS=60
AEGIS_PROVIDER_MAX_CONCURRENT_REQUESTS=10
AEGIS_PROVIDER_MAX_OUTPUT_TOKENS=4096
AEGIS_PROVIDER_RECORDED_FIXTURES_DIR=fixtures/model-responses
AEGIS_PROVIDER_OPENAI_API_KEY=
AEGIS_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AEGIS_PROVIDER_OPENAI_MODEL=gpt-4o-mini
# Local LLM via llama.cpp llama-server run as a HOST binary (OpenAI-compatible API).
# This is the supported default local path. Supply your own GGUF and start the
# host binary (e.g. the AMD ROCm build build-rdna3-gfx1101\bin\llama-server.exe):
#   llama-server -m <model.gguf> --host 127.0.0.1 --port 8086 -c 262144 -ngl 99 -fa on
# It serves /v1/chat/completions, /v1/completions, and /v1/models on :8086/v1.
# When AEGIS itself runs inside a container, use http://host.docker.internal:8086/v1.
AEGIS_PROVIDER_LOCAL_BASE_URL=http://localhost:8086/v1
# llama-server ignores the key unless launched with --api-key; the OpenAI SDK
# still needs a non-empty value, so this placeholder is fine for local dev.
AEGIS_PROVIDER_LOCAL_API_KEY=llama-cpp
# Must match the id llama-server reports at /v1/models (its --alias or GGUF name),
# e.g. Qwen3.5-9B.Q8_0.gguf for the verified local copilot model.
AEGIS_PROVIDER_LOCAL_MODEL=local-model
# Cloud providers that speak the same OpenAI-compatible API. In normal use the key
# and model come from the operator's own account — entered once in Configure Loadout,
# stored encrypted per user, and applied per run — so these stay blank. Set them only
# to drive the whole deployment from one subscription (admin/debug console paths).
AEGIS_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AEGIS_PROVIDER_OPENROUTER_API_KEY=
AEGIS_PROVIDER_OPENROUTER_MODEL=
AEGIS_PROVIDER_OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
AEGIS_PROVIDER_OLLAMA_CLOUD_API_KEY=
AEGIS_PROVIDER_OLLAMA_CLOUD_MODEL=
AEGIS_PROVIDER_IN_MEMORY_ARTIFACTS=false
# Exact, comma-separated base URLs network-capable provider adapters may reach.
# Every adapter checks its base URL against this at construction and fails closed.
AEGIS_PROVIDER_EGRESS_ALLOWLIST=https://api.openai.com/v1,http://localhost:8086/v1,https://openrouter.ai/api/v1,https://ollama.com/v1
# Wall-clock ceiling for one agent task (chat turn), shared across every model
# call the task makes. A local reasoning model can take tens of seconds; tasks
# that exceed this fail soft (shown in the chat).
AEGIS_AGENT_TASK_TIMEOUT_SECONDS=120
# How many investigate-then-answer rounds an agent may take in one task: it asks
# for read-only tools, the runtime runs them and hands back the results, and it
# answers or asks again. Each round costs one extra model call, so this is the
# main cost/latency lever. Minimum 1; state-changing actions never run in these
# rounds — they stay proposals for human approval.
AEGIS_AGENT_TOOL_LOOP_MAX_ITERATIONS=3

# WebSocket gateway (Phase 12)
AEGIS_WS_PATH=/ws/v1/realtime
AEGIS_WS_ENABLED=true
AEGIS_WS_MAX_CONNECTIONS=1000
AEGIS_WS_MAX_QUEUE_DEPTH=256
AEGIS_WS_MAX_MESSAGE_BYTES=65536
AEGIS_WS_HEARTBEAT_INTERVAL_SECONDS=15
AEGIS_WS_IDLE_TIMEOUT_SECONDS=45
AEGIS_WS_DEV_AUTH_ENABLED=true
AEGIS_WS_DEV_AUTH_TOKEN=aegis-dev-token
AEGIS_WS_GATEWAY_CONSUMER_GROUP=aegis-ws-gateway
AEGIS_WS_SNAPSHOT_GAP_THRESHOLD=500

{
  "$defs": {
    "AssetInstanceSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "assetType": {
          "minLength": 1,
          "title": "Assettype",
          "type": "string"
        },
        "criticality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Criticality",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "riskScore": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Riskscore",
          "type": "number"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "zoneId": {
          "minLength": 1,
          "title": "Zoneid",
          "type": "string"
        }
      },
      "required": ["id", "assetType", "status", "riskScore", "criticality", "zoneId", "revision"],
      "title": "AssetInstanceSnapshotV1",
      "type": "object"
    },
    "CampaignRuntimeStateSnapshotV1": {
      "additionalProperties": false,
      "description": "Serialized progression of one attacker kill-chain campaign.\n\nEverything the engine needs to resume a campaign mid-flight: where the attacker is\nstanding, what it has established, which scripted reactions have already fired, and\nthe scheduling bookkeeping that keeps exactly one advance in the event queue. Sets are\nserialized as sorted lists so the checkpoint checksum is stable.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "advancePending": {
          "default": false,
          "title": "Advancepending",
          "type": "boolean"
        },
        "campaignId": {
          "minLength": 1,
          "title": "Campaignid",
          "type": "string"
        },
        "completedTechniqueIds": {
          "items": {
            "type": "string"
          },
          "title": "Completedtechniqueids",
          "type": "array"
        },
        "currentFootholdId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currentfootholdid"
        },
        "dwellMultiplier": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Dwellmultiplier",
          "type": "number"
        },
        "establishedCapabilities": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Establishedcapabilities",
          "type": "object"
        },
        "establishedFootholds": {
          "items": {
            "type": "string"
          },
          "title": "Establishedfootholds",
          "type": "array"
        },
        "firedReactionIds": {
          "items": {
            "type": "string"
          },
          "title": "Firedreactionids",
          "type": "array"
        },
        "haltedAssets": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Haltedassets",
          "type": "object"
        },
        "nextTechniqueIndex": {
          "default": 0,
          "minimum": 0,
          "title": "Nexttechniqueindex",
          "type": "integer"
        },
        "pendingAnchorId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pendinganchorid"
        },
        "revokedCapabilities": {
          "items": {
            "type": "string"
          },
          "title": "Revokedcapabilities",
          "type": "array"
        },
        "scheduleSeq": {
          "default": 0,
          "minimum": 0,
          "title": "Scheduleseq",
          "type": "integer"
        },
        "signalsSuppressed": {
          "default": false,
          "title": "Signalssuppressed",
          "type": "boolean"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": ["campaignId", "status", "active"],
      "title": "CampaignRuntimeStateSnapshotV1",
      "type": "object"
    },
    "GeneratorStateSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "generatorId": {
          "minLength": 1,
          "title": "Generatorid",
          "type": "string"
        },
        "intervalSimSeconds": {
          "minimum": 1,
          "title": "Intervalsimseconds",
          "type": "integer"
        },
        "jitterSimSeconds": {
          "minimum": 0,
          "title": "Jittersimseconds",
          "type": "integer"
        },
        "nextSimTime": {
          "title": "Nextsimtime",
          "type": "string"
        },
        "pluginId": {
          "minLength": 1,
          "title": "Pluginid",
          "type": "string"
        },
        "targetAssetId": {
          "title": "Targetassetid",
          "type": "string"
        }
      },
      "required": [
        "generatorId",
        "targetAssetId",
        "pluginId",
        "nextSimTime",
        "intervalSimSeconds",
        "jitterSimSeconds"
      ],
      "title": "GeneratorStateSnapshotV1",
      "type": "object"
    },
    "HiddenConditionStateSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "conditionId": {
          "minLength": 1,
          "title": "Conditionid",
          "type": "string"
        },
        "revealed": {
          "title": "Revealed",
          "type": "boolean"
        },
        "triggerCount": {
          "default": 0,
          "minimum": 0,
          "title": "Triggercount",
          "type": "integer"
        },
        "triggered": {
          "title": "Triggered",
          "type": "boolean"
        }
      },
      "required": ["conditionId", "revealed", "triggered"],
      "title": "HiddenConditionStateSnapshotV1",
      "type": "object"
    },
    "RelationshipInstanceSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "relationshipType": {
          "minLength": 1,
          "title": "Relationshiptype",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "riskContribution": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Riskcontribution",
          "type": "number"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "targetId": {
          "title": "Targetid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceId",
        "targetId",
        "relationshipType",
        "confidence",
        "riskContribution",
        "revision"
      ],
      "title": "RelationshipInstanceSnapshotV1",
      "type": "object"
    },
    "RunOutcomeSnapshotV1": {
      "additionalProperties": false,
      "description": "The resolved win/lose verdict for a run, once (and only once) it resolves.",
      "properties": {
        "disruptionCost": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Disruptioncost",
          "type": "number"
        },
        "needlessCriticalOutages": {
          "items": {
            "type": "string"
          },
          "title": "Needlesscriticaloutages",
          "type": "array"
        },
        "neutralizedCampaignIds": {
          "items": {
            "type": "string"
          },
          "title": "Neutralizedcampaignids",
          "type": "array"
        },
        "outcome": {
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "peakDisruptionCost": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Peakdisruptioncost",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "resolvedSequence": {
          "minimum": 0,
          "title": "Resolvedsequence",
          "type": "integer"
        },
        "resolvedSimTime": {
          "title": "Resolvedsimtime",
          "type": "string"
        },
        "succeededCampaignIds": {
          "items": {
            "type": "string"
          },
          "title": "Succeededcampaignids",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "reason",
        "resolvedSimTime",
        "resolvedSequence",
        "disruptionCost",
        "peakDisruptionCost"
      ],
      "title": "RunOutcomeSnapshotV1",
      "type": "object"
    },
    "ScheduledEventSourceType": {
      "enum": ["scheduled", "generator"],
      "title": "ScheduledEventSourceType",
      "type": "string"
    },
    "ScheduledEventV1": {
      "additionalProperties": false,
      "properties": {
        "branchGateBranchId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branchgatebranchid"
        },
        "branchGateGroup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branchgategroup"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "eventId": {
          "minLength": 1,
          "title": "Eventid",
          "type": "string"
        },
        "pluginId": {
          "minLength": 1,
          "title": "Pluginid",
          "type": "string"
        },
        "priority": {
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "simTime": {
          "title": "Simtime",
          "type": "string"
        },
        "sourceType": {
          "$ref": "#/$defs/ScheduledEventSourceType"
        },
        "targetAssetId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targetassetid"
        },
        "tieBreaker": {
          "minimum": 0,
          "title": "Tiebreaker",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "simTime",
        "priority",
        "tieBreaker",
        "sourceType",
        "pluginId"
      ],
      "title": "ScheduledEventV1",
      "type": "object"
    },
    "SimulationRunStatus": {
      "enum": ["created", "running", "paused", "stopped"],
      "title": "SimulationRunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetInstanceSnapshotV1"
      },
      "title": "Assets",
      "type": "array"
    },
    "campaigns": {
      "items": {
        "$ref": "#/$defs/CampaignRuntimeStateSnapshotV1"
      },
      "title": "Campaigns",
      "type": "array"
    },
    "generators": {
      "items": {
        "$ref": "#/$defs/GeneratorStateSnapshotV1"
      },
      "title": "Generators",
      "type": "array"
    },
    "hiddenConditions": {
      "items": {
        "$ref": "#/$defs/HiddenConditionStateSnapshotV1"
      },
      "title": "Hiddenconditions",
      "type": "array"
    },
    "nextSequence": {
      "minimum": 0,
      "title": "Nextsequence",
      "type": "integer"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunOutcomeSnapshotV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "peakDisruptionCost": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Peakdisruptioncost",
      "type": "number"
    },
    "pendingEvents": {
      "items": {
        "$ref": "#/$defs/ScheduledEventV1"
      },
      "title": "Pendingevents",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/RelationshipInstanceSnapshotV1"
      },
      "title": "Relationships",
      "type": "array"
    },
    "rngState": {
      "additionalProperties": {
        "items": {
          "type": "integer"
        },
        "type": "array"
      },
      "title": "Rngstate",
      "type": "object"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "selectedBranches": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Selectedbranches",
      "type": "object"
    },
    "simTime": {
      "title": "Simtime",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SimulationRunStatus"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "simTime",
    "nextSequence",
    "assets",
    "relationships",
    "generators"
  ],
  "title": "WorldStateSnapshotV1",
  "type": "object"
}

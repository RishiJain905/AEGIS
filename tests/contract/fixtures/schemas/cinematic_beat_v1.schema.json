{
  "$defs": {
    "CinematicBeatKindV1": {
      "enum": [
        "establishing",
        "incident_origin",
        "evidence_focus",
        "path_trace",
        "agent_investigation",
        "risk_change",
        "proposal_focus",
        "approval_moment",
        "consequence_reveal",
        "report_focus",
        "overview"
      ],
      "title": "CinematicBeatKindV1",
      "type": "string"
    },
    "CinematicProvenanceSourceV1": {
      "enum": ["replay_state", "presentation_hint", "default_planner"],
      "title": "CinematicProvenanceSourceV1",
      "type": "string"
    },
    "CinematicProvenanceV1": {
      "additionalProperties": false,
      "description": "Links a cinematic beat to authoritative replay cursor/entity provenance.",
      "properties": {
        "entityIds": {
          "items": {
            "type": "string"
          },
          "title": "Entityids",
          "type": "array"
        },
        "incidentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incidentid"
        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "simTime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simtime"
        },
        "source": {
          "$ref": "#/$defs/CinematicProvenanceSourceV1"
        },
        "stateDigest": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statedigest"
        }
      },
      "required": ["schemaVersion", "runId", "sequence", "source"],
      "title": "CinematicProvenanceV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One directed cinematic moment tied to an authoritative replay sequence.",
  "properties": {
    "cameraDirectiveId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Cameradirectiveid",
      "type": "string"
    },
    "caption": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Caption",
      "type": "string"
    },
    "chapterId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Chapterid",
      "type": "string"
    },
    "entityIds": {
      "items": {
        "type": "string"
      },
      "title": "Entityids",
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CinematicBeatKindV1"
    },
    "pathEntityIds": {
      "items": {
        "type": "string"
      },
      "title": "Pathentityids",
      "type": "array"
    },
    "priority": {
      "default": 100,
      "maximum": 1000,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/CinematicProvenanceV1"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "simTime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Simtime"
    },
    "tieBreaker": {
      "default": 0,
      "maximum": 1000000,
      "minimum": 0,
      "title": "Tiebreaker",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "chapterId",
    "kind",
    "sequence",
    "caption",
    "cameraDirectiveId",
    "provenance"
  ],
  "title": "CinematicBeatV1",
  "type": "object"
}

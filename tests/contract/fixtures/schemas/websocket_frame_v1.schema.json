{
  "$defs": {
    "WebSocketMessageType": {
      "enum": [
        "hello",
        "hello_ack",
        "subscribe",
        "unsubscribe",
        "pong",
        "subscribed",
        "event",
        "warning",
        "error",
        "snapshot_required",
        "ping",
        "resync_complete"
      ],
      "title": "WebSocketMessageType",
      "type": "string"
    }
  },
  "additionalProperties": false,

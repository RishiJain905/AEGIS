      "title": "Protocolversion",
      "type": "integer"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "sentAt": {
      "title": "Sentat",
      "type": "string"
    },
    "traceId": {
      "title": "Traceid",
      "type": "string"
    }

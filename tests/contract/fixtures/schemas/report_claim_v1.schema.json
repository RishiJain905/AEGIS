{
  "$defs": {
    "ReportCitationKindV1": {
      "enum": [
        "event",
        "evidence",
        "hypothesis",
        "proposal",
        "policy_decision",
        "model_score",
        "agent_task",
        "agent_session",
        "alert",
        "asset"
      ],
      "title": "ReportCitationKindV1",
      "type": "string"
    },
    "ReportCitationV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReportCitationKindV1"
        },
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "maxLength": 2048,
          "title": "Rationale",
          "type": "string"
        },
        "referenceId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Referenceid",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "referenceId",
        "label"
      ],
      "title": "ReportCitationV1",
      "type": "object"
    },
    "ReportClaimCategoryV1": {
      "enum": [
        "observed_fact",
        "persisted_event",
        "detection_score",
        "graph_risk",
        "investigation_evidence",
        "oracle_hypothesis",
        "bastion_proposal",
        "warden_policy_decision",
        "human_decision",
        "agent_inference",
        "unsupported",
        "uncertain"
      ],
      "title": "ReportClaimCategoryV1",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "$ref": "#/$defs/ReportClaimCategoryV1"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/ReportCitationV1"
      },
      "title": "Citations",
      "type": "array"
    },
    "claimId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Claimid",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "grounded": {
      "default": true,
      "title": "Grounded",
      "type": "boolean"
    },
    "rejectionReason": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejectionreason"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "uncertainty": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty"
    }
  },
  "required": [
    "schemaVersion",
    "claimId",
    "category",
    "text"
  ],
  "title": "ReportClaimV1",
  "type": "object"
}

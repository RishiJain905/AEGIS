        "investigation:read",
        "investigation:trigger",
        "approvals:decide",
        "replay:read",
        "replay:write",
        "reports:read",
        "reports:export",
        "reports:trigger",
        "scoring:read",
        "scoring:compute",
        "scoring:export",
        "scenarios:publish",
        "admin:manage",
        "ws:subscribe"

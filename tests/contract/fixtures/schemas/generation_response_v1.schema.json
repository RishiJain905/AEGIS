{
  "$defs": {
    "ProviderFinishReason": {
      "enum": [
        "stop",
        "length",
        "tool_calls",
        "content_filter",
        "error"
      ],
      "title": "ProviderFinishReason",
      "type": "string"
    },
    "ProviderUsageV1": {
      "additionalProperties": false,
      "properties": {
        "completionTokens": {
          "minimum": 0,
          "title": "Completiontokens",
          "type": "integer"
        },
        "estimatedCostUsd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedcostusd"
        },
        "promptTokens": {
          "minimum": 0,
          "title": "Prompttokens",
          "type": "integer"
        },
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "totalTokens": {
          "minimum": 0,
          "title": "Totaltokens",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "promptTokens",
        "completionTokens",
        "totalTokens"
      ],
      "title": "ProviderUsageV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifactRef": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifactref"
    },
    "completedAt": {
      "title": "Completedat",
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    },
    "finishReason": {
      "$ref": "#/$defs/ProviderFinishReason"
    },
    "latencyMs": {
      "minimum": 0,
      "title": "Latencyms",
      "type": "integer"
    },
    "modelId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Modelid",
      "type": "string"
    },
    "promptVersion": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Promptversion",
      "type": "string"
    },
    "providerId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Providerid",
      "type": "string"
    },
    "requestId": {
      "title": "Requestid",
      "type": "string"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "structuredData": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structureddata"
    },
    "traceId": {
      "title": "Traceid",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/ProviderUsageV1"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "providerId",
    "modelId",
    "promptVersion",
    "finishReason",
    "usage",
    "latencyMs",
    "completedAt"
  ],
  "title": "GenerationResponseV1",
  "type": "object"
}

    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": ["schemaVersion", "idempotencyKey"],
  "title": "CreateAgentTaskRequestV1",
  "type": "object"
}

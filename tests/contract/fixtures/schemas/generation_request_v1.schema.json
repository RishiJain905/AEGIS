{
  "$defs": {
    "GenerationMessageRole": {
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "title": "GenerationMessageRole",
      "type": "string"
    },
    "GenerationMessageV1": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 65536,
          "minLength": 0,
          "title": "Content",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "$ref": "#/$defs/GenerationMessageRole"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "GenerationMessageV1",
      "type": "object"
    },
    "ModelConfigV1": {
      "additionalProperties": false,
      "properties": {
        "maxOutputTokens": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxoutputtokens"
        },
        "modelId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Modelid",
          "type": "string"
        },
        "promptVersion": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Promptversion",
          "type": "string"
        },
        "providerId": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Providerid",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "schemaVersion",
        "providerId",
        "modelId",
        "promptVersion"
      ],
      "title": "ModelConfigV1",
      "type": "object"
    },
    "ProviderCapability": {
      "enum": [
        "structured_output",
        "tools",
        "vision",
        "streaming"
      ],
      "title": "ProviderCapability",
      "type": "string"
    },
    "StructuredOutputSpecV1": {
      "additionalProperties": false,
      "properties": {
        "jsonSchema": {
          "additionalProperties": true,
          "title": "Jsonschema",
          "type": "object"
        },
        "maxRepairAttempts": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Maxrepairattempts",
          "type": "integer"
        },
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "strict": {
          "default": true,
          "title": "Strict",
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "jsonSchema"
      ],
      "title": "StructuredOutputSpecV1",
      "type": "object"
    },
    "ToolSchemaV1": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "description"
      ],
      "title": "ToolSchemaV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capabilitiesRequired": {
      "items": {
        "$ref": "#/$defs/ProviderCapability"
      },
      "title": "Capabilitiesrequired",
      "type": "array"
    },
    "correlationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlationid"
    },
    "idempotencyKey": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotencykey"
    },
    "maxOutputTokens": {
      "default": 4096,
      "maximum": 65536,
      "minimum": 1,
      "title": "Maxoutputtokens",
      "type": "integer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/GenerationMessageV1"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "modelConfig": {
      "$ref": "#/$defs/ModelConfigV1"
    },
    "providerId": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Providerid"
    },
    "requestId": {
      "title": "Requestid",
      "type": "string"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "structuredOutput": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredOutputSpecV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timeoutMs": {
      "anyOf": [
        {
          "maximum": 600000,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeoutms"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolSchemaV1"
      },
      "maxItems": 32,
      "title": "Tools",
      "type": "array"
    },
    "traceId": {
      "title": "Traceid",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "modelConfig",
    "messages"
  ],
  "title": "GenerationRequestV1",
  "type": "object"
}

      "enum": [
        "created",
        "running",
        "paused",
        "stopped"
      ],
      "title": "SimulationRunStatus",
      "type": "string"
    },
    "WorldStateSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/AssetInstanceSnapshotV1"
          },
          "title": "Assets",
          "type": "array"
        },
        "generators": {
          "items": {
            "$ref": "#/$defs/GeneratorStateSnapshotV1"
          },
          "title": "Generators",
          "type": "array"
        },
        "hiddenConditions": {
          "items": {
            "$ref": "#/$defs/HiddenConditionStateSnapshotV1"
          },
          "title": "Hiddenconditions",
          "type": "array"
        },
        "nextSequence": {
          "minimum": 0,
          "title": "Nextsequence",
          "type": "integer"
        },
        "pendingEvents": {
          "items": {
            "$ref": "#/$defs/ScheduledEventV1"
          },
          "title": "Pendingevents",
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/RelationshipInstanceSnapshotV1"
          },
          "title": "Relationships",
          "type": "array"
        },
        "rngState": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Rngstate",
          "type": "object"
        },
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "selectedBranches": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Selectedbranches",
          "type": "object"
        },
        "simTime": {
          "title": "Simtime",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SimulationRunStatus"
        }

        "generatorId": {
          "minLength": 1,
          "title": "Generatorid",
          "type": "string"
        },
        "intervalSimSeconds": {
          "minimum": 1,
          "title": "Intervalsimseconds",
          "type": "integer"
        },
        "jitterSimSeconds": {
          "minimum": 0,
          "title": "Jittersimseconds",
          "type": "integer"
        },
        "nextSimTime": {
          "title": "Nextsimtime",
          "type": "string"
        },
        "pluginId": {
          "minLength": 1,
          "title": "Pluginid",
          "type": "string"
        },
        "targetAssetId": {
          "title": "Targetassetid",
          "type": "string"
        }
      },
      "required": [
        "generatorId",
        "targetAssetId",
        "pluginId",
        "nextSimTime",
        "intervalSimSeconds",
        "jitterSimSeconds"
      ],
      "title": "GeneratorStateSnapshotV1",
      "type": "object"
    },
    "HiddenConditionStateSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "conditionId": {
          "minLength": 1,
          "title": "Conditionid",
          "type": "string"
        },
        "revealed": {
          "title": "Revealed",
          "type": "boolean"
        },
        "triggerCount": {
          "default": 0,
          "minimum": 0,
          "title": "Triggercount",
          "type": "integer"
        },
        "triggered": {
          "title": "Triggered",
          "type": "boolean"
        }
      },
      "required": [
        "conditionId",
        "revealed",
        "triggered"

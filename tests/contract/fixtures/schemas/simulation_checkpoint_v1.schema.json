      "required": [
        "schemaVersion",
        "status",
        "simTime",
        "nextSequence",
        "assets",
        "relationships",
        "generators"
      ],
      "title": "WorldStateSnapshotV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checksum": {
      "minLength": 1,
      "title": "Checksum",
      "type": "string"
    },
    "createdAt": {
      "title": "Createdat",
      "type": "string"
    },
    "engineVersion": {
      "minLength": 1,
      "title": "Engineversion",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "sequenceAtCheckpoint": {
      "minimum": 0,
      "title": "Sequenceatcheckpoint",
      "type": "integer"
    },
    "worldState": {
      "$ref": "#/$defs/WorldStateSnapshotV1"
    }

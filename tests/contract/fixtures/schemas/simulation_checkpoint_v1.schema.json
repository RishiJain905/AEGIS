{
  "$defs": {
    "AssetInstanceSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "assetType": {
          "minLength": 1,
          "title": "Assettype",
          "type": "string"
        },
        "criticality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Criticality",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "riskScore": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Riskscore",
          "type": "number"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "zoneId": {
          "minLength": 1,
          "title": "Zoneid",
          "type": "string"
        }

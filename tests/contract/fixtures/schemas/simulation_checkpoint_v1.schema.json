    "RelationshipInstanceSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "relationshipType": {
          "minLength": 1,
          "title": "Relationshiptype",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "riskContribution": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Riskcontribution",
          "type": "number"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "targetId": {
          "title": "Targetid",
          "type": "string"

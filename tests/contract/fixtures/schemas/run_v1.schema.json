{
  "$defs": {
    "RulesOfEngagementV1": {
      "description": "Per-run autonomy dial (Phase 7). Higher tiers let agents act more proactively;\nevery state change still passes policy + human approval (Class 2/3 never auto-execute).",
      "enum": ["observe", "investigate", "forward_deployed"],
      "title": "RulesOfEngagementV1",
      "type": "string"
    },
    "RunLoadoutV1": {
      "additionalProperties": false,
      "description": "Per-run capability loadout chosen at launch; a variety axis alongside the seed.",
      "properties": {
        "biasGuard": {
          "default": true,
          "title": "Biasguard",
          "type": "boolean"
        },
        "modelId": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelid"
        },
        "providerId": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providerid"
        },
        "roe": {
          "$ref": "#/$defs/RulesOfEngagementV1",
          "default": "investigate"
        },
        "schemaVersion": {
          "default": 1,
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "threatTempo": {
          "default": true,
          "title": "Threattempo",
          "type": "boolean"
        }
      },
      "title": "RunLoadoutV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "commanderIntent": {
      "anyOf": [
        {
          "maxLength": 280,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commanderintent"
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Createdat"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "loadout": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunLoadoutV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ownerUserId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owneruserid"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "scenarioVersionId": {
      "title": "Scenarioversionid",
      "type": "string"
    },
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "simTime": {
      "title": "Simtime",
      "type": "string"
    },
    "startedAt": {
      "title": "Startedat",
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "scenarioVersionId",
    "seed",
    "status",
    "startedAt",
    "simTime",
    "revision"
  ],
  "title": "RunV1",
  "type": "object"
}

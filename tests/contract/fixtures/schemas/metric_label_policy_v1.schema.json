{
  "$defs": {
    "MetricTypeV1": {
      "enum": ["counter", "histogram", "gauge", "up_down_counter"],
      "title": "MetricTypeV1",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Documents allowed metric labels and forbids unbounded cardinality labels.",

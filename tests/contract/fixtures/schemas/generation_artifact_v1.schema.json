{
  "$defs": {
    "ProviderErrorCode": {
      "enum": [
        "VALIDATION_FAILED",
        "CAPABILITY_UNSUPPORTED",
        "CREDENTIALS_MISSING",
        "OUTPUT_LIMIT_EXCEEDED",
        "STRUCTURED_OUTPUT_INVALID",
        "TIMEOUT",
        "RETRY_EXHAUSTED",
        "CIRCUIT_OPEN",
        "PROVIDER_UNAVAILABLE",
        "CANCELLATION",
        "INTERNAL"
      ],
      "title": "ProviderErrorCode",
      "type": "string"
    },
    "ProviderErrorV1": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "code": {
          "$ref": "#/$defs/ProviderErrorCode"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "traceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceid"
        }
      },
      "required": [
        "schemaVersion",
        "code",
        "message"
      ],
      "title": "ProviderErrorV1",
      "type": "object"
    },
    "ProviderUsageV1": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "minimum": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "promptTokens": {
          "minimum": 0,
          "title": "Prompttokens",
          "type": "integer"
        },
        "completionTokens": {
          "minimum": 0,
          "title": "Completiontokens",
          "type": "integer"
        },
        "totalTokens": {
          "minimum": 0,
          "title": "Totaltokens",
          "type": "integer"
        },
        "estimatedCostUsd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedcostusd"
        }
      },
      "required": [
        "schemaVersion",
        "promptTokens",
        "completionTokens",
        "totalTokens"
      ],
      "title": "ProviderUsageV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "minimum": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "requestId": {
      "title": "Requestid",
      "type": "string"
    },
    "traceId": {
      "title": "Traceid",
      "type": "string"
    },
    "providerId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Providerid",
      "type": "string"
    },
    "modelId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Modelid",
      "type": "string"
    },
    "promptVersion": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Promptversion",
      "type": "string"
    },
    "latencyMs": {
      "minimum": 0,
      "title": "Latencyms",
      "type": "integer"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderUsageV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderErrorV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sanitizedRequest": {
      "additionalProperties": true,
      "title": "Sanitizedrequest",
      "type": "object"
    },
    "sanitizedResponse": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sanitizedresponse"
    },
    "objectStorageRef": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objectstorageref"
    },
    "recordedAt": {
      "format": "date-time",
      "title": "Recordedat",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "providerId",
    "modelId",
    "promptVersion",
    "latencyMs",
    "sanitizedRequest",
    "recordedAt"
  ],
  "title": "GenerationArtifactV1",
  "type": "object"
}

      "title": "Assetid",
      "type": "string"
    },
    "assetType": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assettype"
    },
    "clusterId": {

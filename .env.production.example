# Production-shaped local Compose values only. Every credential-like value is
# intentionally fake, local-only, and must be replaced by a secret manager
# reference before any future cloud activation. Do not add real credentials.

AEGIS_ENV=production
LOG_LEVEL=info

# Container-network addresses. The smoke-only host port is not used by apps.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=phase33-local-postgres-password
AEGIS_SMOKE_POSTGRES_PORT=55432

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=phase33-local-object-user
S3_SECRET_KEY=phase33-local-object-secret
S3_BUCKET=aegis-artifacts

API_PORT=8000
WEB_PORT=3000
# Host-only loopback bindings used by the local readiness rehearsal.
AEGIS_API_HOST_PORT=18000
AEGIS_WEB_HOST_PORT=13000
AEGIS_LOCAL_URL=http://127.0.0.1:18000
AEGIS_LOCAL_WS_URL=ws://127.0.0.1:18000/ws/v1/realtime
NEXT_PUBLIC_AEGIS_DATA_SOURCE=api
NEXT_PUBLIC_API_BASE_URL=http://localhost:18000
NEXT_PUBLIC_WS_URL=ws://localhost:18000/ws/v1/realtime
NEXT_PUBLIC_AEGIS_WS_TOKEN=
NEXT_PUBLIC_AEGIS_CSRF_COOKIE_NAME=aegis_csrf

# Production startup must use OIDC and session-derived WebSocket auth. These
# invalid.example values are shape-valid placeholders for local boot only.
AEGIS_DEV_AUTH_ENABLED=false
AEGIS_SESSION_COOKIE_NAME=aegis_session
AEGIS_CSRF_COOKIE_NAME=aegis_csrf
AEGIS_CSRF_HEADER_NAME=X-CSRF-Token
AEGIS_SESSION_TTL_SECONDS=28800
AEGIS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:13000,http://localhost:13000
AEGIS_OIDC_ENABLED=true
AEGIS_OIDC_ISSUER=https://oidc.phase33.invalid.example
AEGIS_OIDC_CLIENT_ID=phase33-local-oidc-client
AEGIS_OIDC_CLIENT_SECRET=phase33-local-oidc-client-secret
AEGIS_OIDC_REDIRECT_URI=https://aegis.phase33.invalid.example/api/v1/auth/callback
AEGIS_OIDC_SCOPES=openid profile email
AEGIS_WEB_BASE_URL=https://aegis.phase33.invalid.example

# Phase 31 observability, addressed on the Compose network.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aegis-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_EXPORT_INTERVAL_MS=15000
OTEL_EXPORTER_FAILURE_MODE=ignore
AEGIS_HEALTH_PROBE_TIMEOUT_MS=2000
AEGIS_READY_REQUIRE_REDIS=true
AEGIS_READY_REQUIRE_OBJECT_STORAGE=true
AEGIS_LOG_JSON=true
AEGIS_TELEMETRY_RETENTION_HOURS=168

# Phase 32 API hardening; preserve these values in production manifests.
AEGIS_REQUEST_BODY_MAX_BYTES=1048576
AEGIS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
AEGIS_RATE_LIMIT_BURST=30
AEGIS_RATE_LIMIT_MAX_BUCKETS=10000
AEGIS_SECURITY_HSTS_ENABLED=false
AEGIS_SECURITY_HSTS_MAX_AGE_SECONDS=31536000

AEGIS_WORKER_MODE=outbox-relay

# Provider defaults remain deterministic and offline for this local rehearsal.
AEGIS_PROVIDER_DEFAULT=mock
AEGIS_PROVIDER_TIMEOUT_SECONDS=60
AEGIS_PROVIDER_MAX_RETRIES=3
AEGIS_PROVIDER_RETRY_BACKOFF_SECONDS=1
AEGIS_PROVIDER_CIRCUIT_BREAKER_THRESHOLD=5
AEGIS_PROVIDER_CIRCUIT_BREAKER_RESET_SECONDS=60
AEGIS_PROVIDER_MAX_CONCURRENT_REQUESTS=10
AEGIS_PROVIDER_MAX_OUTPUT_TOKENS=4096
AEGIS_PROVIDER_RECORDED_FIXTURES_DIR=fixtures/model-responses
AEGIS_PROVIDER_OPENAI_API_KEY=
AEGIS_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AEGIS_PROVIDER_OPENAI_MODEL=gpt-4o-mini
AEGIS_PROVIDER_LOCAL_BASE_URL=http://localhost:11434/v1
AEGIS_PROVIDER_LOCAL_API_KEY=phase33-local-provider-key
AEGIS_PROVIDER_LOCAL_MODEL=llama3.2
AEGIS_PROVIDER_IN_MEMORY_ARTIFACTS=false
AEGIS_PROVIDER_EGRESS_ALLOWLIST=https://api.openai.com/v1,http://localhost:11434/v1

# Phase 12/30 WebSocket contract; dev auth is explicitly disabled.
AEGIS_WS_PATH=/ws/v1/realtime
AEGIS_WS_ENABLED=true
AEGIS_WS_MAX_CONNECTIONS=1000
AEGIS_WS_MAX_QUEUE_DEPTH=256
AEGIS_WS_MAX_MESSAGE_BYTES=65536
AEGIS_WS_HEARTBEAT_INTERVAL_SECONDS=15
AEGIS_WS_IDLE_TIMEOUT_SECONDS=45
AEGIS_WS_DEV_AUTH_ENABLED=false
AEGIS_WS_DEV_AUTH_TOKEN=phase33-disabled-ws-token
AEGIS_WS_GATEWAY_CONSUMER_GROUP=aegis-ws-gateway
AEGIS_WS_SNAPSHOT_GAP_THRESHOLD=500

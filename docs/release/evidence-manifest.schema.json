{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/release-evidence-v1.json",
  "title": "AEGIS Release Evidence Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "timestamp",
    "environment",
    "revision",
    "status",
    "scenario",
    "commandResults",
    "artifactPaths"
  ],
  "properties": {
    "schemaVersion": { "const": "aegis.release-evidence/v1" },
    "runId": { "type": "string", "pattern": "^release-[0-9TZ]+-[0-9a-f]{8}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "environment": { "const": "local" },
    "revision": { "type": "string", "minLength": 7 },
    "status": { "enum": ["passed", "failed"] },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "seed"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer" }
      }
    },
    "commandResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "exitCode",
          "startedAt",
          "durationSeconds",
          "artifactPath",
          "outputTail"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "exitCode": { "type": ["integer", "null"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "durationSeconds": { "type": "number", "minimum": 0 },
          "artifactPath": { "type": "string", "minLength": 1 },
          "outputTail": { "type": "string" }
        }
      }
    },
    "artifactPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "performance": { "type": "string", "minLength": 1 },
        "e2e": { "type": "string", "minLength": 1 }
      }
    }
  }
}
